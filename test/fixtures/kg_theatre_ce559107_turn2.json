    "tool_name": "base_readQuery",
    "arguments": {
     "sql": "SELECT\n  SUBSTR(incident_date_text, 4, 3) AS month_text,\n  COUNT(*) AS robbery_count\nFROM Policing_Core.v_Incident I\nJOIN Policing_Core.v_Offence O\n  ON I.ori = O.ori AND I.incident_number = O.incident_number\nWHERE O.offence_code = '120'\n  AND SUBSTR(incident_date_text, 8, 4) = '2023'\nGROUP BY month_text\nORDER BY\n  CASE\n    WHEN month_text = 'JAN' THEN 1\n    WHEN month_text = 'FEB' THEN 2\n    WHEN month_text = 'MAR' THEN 3\n    WHEN month_text = 'APR' THEN 4\n    WHEN month_text = 'MAY' THEN 5\n    WHEN month_text = 'JUN' THEN 6\n    WHEN month_text = 'JUL' THEN 7\n    WHEN month_text = 'AUG' THEN 8\n    WHEN month_text = 'SEP' THEN 9\n    WHEN month_text = 'OCT' THEN 10\n    WHEN month_text = 'NOV' THEN 11\n    WHEN month_text = 'DEC' THEN 12\n  END;"
