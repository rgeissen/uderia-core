*~
.DS_Store

# ChromaDB Cache (exclude - will be rebuilt)
.chromadb_rag_cache/
chroma_db/
tda_chroma_db/

# Logs
logs/
*.log

# Sensitive data
*.env
!.env.example
tda_auth.db
tda_auth.db-*

# Keys and certificates
# Note: jwt_secret.key is distributed with the application
# Users should regenerate it using: python maintenance/regenerate_jwt_secret.py

# License directory (not distributed)
trusted-data-agent-license/

# Custom prompt overrides (not distributed)
prompt_overrides/

# TDA keys - environment-specific files must never be committed
# license.key is the App Developer tier dev license — tracked so a fresh
# clone is runnable. Higher-tier licenses (Enterprise/prod) live outside
# the repo and the operator overwrites license.key locally before deploy.
tda_keys/jwt_secret.key
# The licence signing key never enters the repository (maintenance/licensing/ holds only the tools)
maintenance/licensing/*.pem
tda_keys/provenance_key.pem
tda_keys/provenance_key.pub
tda_keys/test_*.pem

# RAG directory (session data - excluded from distribution)
/rag/

# TDA sessions (excluded from distribution)
tda_sessions/


# Marketplace runtime data (kg_export.json + manifest.json per published KG;
# similar role to tda_sessions — generated by the publish endpoint, not source)
marketplace_data/

# Temporary files
*.tmp
*.bak
*.swp
.cache/

# OS
.DS_Store
Thumbs.db

# Docker
.dockerignore

# Test coverage
.coverage
htmlcov/
.pytest_cache/

test/inference_profile_test.py

# Gemini
.gemini/

# Claude Code local settings (contains session-specific tokens)
.claude/settings.local.json

# Agent packs - corpus data, import artifacts, and pipeline config (not distributed)
agent_packs/*/corpus/
agent_packs/*/import_output/
agent_packs/*/pipeline_config.json
# ANDP: variant skill dirs materialized when importing a --variant build (e.g. ai-native-data-product-c).
# Per-instance runtime install state, regenerated on import; the canonical ai-native-data-product/ stays tracked.
skills/user/ai-native-data-product-*/
# WS3 eval store (local SQLite + online-eval sink)
tda_eval.db
tda_eval.db-shm
tda_eval.db-wal
tda_eval/

# MCP endpoint secrets stay on the host, one per endpoint directory
deploy/mcp/*/.env

# Installed user skills (runtime state — never tracked; see skills/manager.py)
tda_skills/

# timestamped maintenance backups (created by maintenance/*.py --apply)
tda_auth.db.bak-*

# PROP-010 file store (platform local): encrypted objects, never source
tda_files/

# daily verified database backups (core/db_health.py)
backups/db/

# a deployment's OWN licence (core/license_file.py) — wins over the repository's
# tda_keys/license.key and must never be committed or overwritten by a pull
tda_keys/license.local.key
tda_keys/license.local.key.previous
*.pyc
.env
*.db
*.db-*
